# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string for Prisma and Node.js
DATABASE_URL="postgresql://ssii_user:ssii_pass_2024@localhost:5432/ssii_ia_platform"

# Separate components for other tools
DB_HOST=localhost
DB_PORT=5432
DB_USER=ssii_user
DB_PASSWORD=ssii_pass_2024
DB_NAME=ssii_ia_platform

# ============================================
# REDIS CONFIGURATION
# ============================================

REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment: development, staging, production
NODE_ENV=development

# Application port
PORT=3000
API_PORT=8000

# ============================================
# SECURITY
# ============================================

# JWT secret key (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Session secret
SESSION_SECRET=your-super-secret-session-key-change-this

# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=10

# ============================================
# API KEYS & INTEGRATIONS
# ============================================

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# GitHub Integration
GITHUB_TOKEN=ghp_your-github-token
GITHUB_ORG=your-org-name

# Vercel Integration
VERCEL_TOKEN=your-vercel-token

# Stripe (for billing)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# EMAIL CONFIGURATION
# ============================================

# Email provider (e.g., Resend, SendGrid)
EMAIL_FROM=noreply@ssii.com
RESEND_API_KEY=re_your-resend-api-key

# ============================================
# STORAGE CONFIGURATION
# ============================================

# S3 or compatible storage
S3_BUCKET=ssii-uploads
S3_REGION=eu-west-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# ============================================
# MONITORING & LOGGING
# ============================================

# Enable SQL query logging
SQL_ECHO=false

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_AI_AGENTS=true
ENABLE_AUTO_DEPLOY=false

# ============================================
# RATE LIMITING
# ============================================

# Rate limit per IP (requests per minute)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# CORS SETTINGS
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# DOCKER CONFIGURATION
# ============================================

# pgAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@ssii.com
PGADMIN_DEFAULT_PASSWORD=admin

# ============================================
# AI AGENT CONFIGURATION
# ============================================

# Maximum tokens per agent execution
MAX_TOKENS=4000

# Agent timeout (seconds)
AGENT_TIMEOUT=300

# Concurrent agent executions
MAX_CONCURRENT_AGENTS=3

# ============================================
# DEVELOPMENT
# ============================================

# Enable debug mode
DEBUG=false

# Enable hot reload
HOT_RELOAD=true

# Seed database on start
AUTO_SEED=false
